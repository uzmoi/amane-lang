{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "files": { "ignoreUnknown": true },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space"
  },
  "assist": {
    "actions": { "recommended": true }
  },
  "linter": {
    "enabled": true,
    "includes": ["**", "!**/*.d.ts"],
    "domains": {
      "project": "all",
      "test": "all"
    },
    "rules": {
      "recommended": true,
      "correctness": {
        "noEmptyCharacterClassInRegex": "off",
        "useImportExtensions": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noUnusedTemplateLiteral": "warn"
      },
      "suspicious": {
        "noConstEnum": "off",
        "noThenProperty": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/cli/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" }
        }
      }
    }
  ]
}
