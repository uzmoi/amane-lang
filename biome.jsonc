{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "files": { "ignoreUnknown": true },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space"
  },
  "assist": {
    "actions": { "recommended": true }
  },
  "linter": {
    "enabled": true,
    "includes": ["**", "!**/*.d.ts"],
    "domains": {
      "project": "all",
      "test": "all"
    },
    "rules": {
      "recommended": true,
      "correctness": {
        "noEmptyCharacterClassInRegex": "off",
        "useImportExtensions": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noUnusedTemplateLiteral": "warn",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "conventions": [
              // 外部ライブラリとの互換のため
              {
                "selector": { "kind": "objectLiteralMember" },
                "formats": ["snake_case", "camelCase"]
              },
              {
                "selector": { "kind": "enumMember" },
                "formats": ["snake_case", "PascalCase"]
              },
              { "selector": { "kind": "typeLike" }, "formats": ["PascalCase"] },
              {
                "selector": { "kind": "namespaceLike" },
                "formats": ["PascalCase"]
              },
              { "formats": ["snake_case"] }
            ]
          }
        }
      },
      "suspicious": {
        "noConstEnum": "off",
        "noThenProperty": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/cli/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" }
        }
      }
    }
  ]
}
